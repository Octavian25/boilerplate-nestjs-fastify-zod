            "  ) {",
            "    super();",
            "  }",
            "  public async execute({ data, user }: TCreate<FTName | pascalcase>Payload) {",
            "    //TODO: put your unique variables inside curly brackets, this function will make sure you don't create duplicate data",
            "    await this.<FTName | camelcase>Repository.findOneAndThrow({});",
            "    try {",
            "      const userEntity = await <FTName | pascalcase>Entity.create({",
            "        name: data.name,",
            "        input_by: user?.user_id ?? 'SYSTEM',",
            "        input_date: new Date(),",
            "      });",
            "      const result = await this.<FTName | camelcase>Repository.save(userEntity);",
            "      return new ResponseDto({ status: HttpStatus.CREATED, data: result });",
            "    } catch (err) {",
            "      this.logger.error(err);",
            "      throw new HttpException(",
            "        { message: err.message || err },",
            "        err.message.includes('exists')",
